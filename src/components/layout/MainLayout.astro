---
import "../../styles/global.css";
import TopNav from "./TopNav.astro";

const { title = "Mundial 2026 Predictor" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="App de predicciones, bracket, partidos, selecciones y ranking para el Mundial 2026." />
    <link rel="icon" href="/favicon.png" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#020617" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-50 antialiased">
    <div class="pointer-events-none fixed inset-0 -z-10 wc-grid-bg opacity-40"></div>
    <div class="pointer-events-none fixed left-1/2 top-0 -z-10 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-yellow-400/10 blur-3xl"></div>
    <TopNav />
    <slot name="hero" />
    <main class="mx-auto max-w-7xl px-4 py-6 md:px-6 md:py-8">
      <slot />
    </main>
  </body>
</html>
